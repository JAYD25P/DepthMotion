+package com.jaydeep.depthmotion
+
+import android.app.WallpaperManager
+import android.graphics.Canvas
+import android.graphics.Color
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.service.wallpaper.WallpaperService
+import android.view.Choreographer
+import android.view.SurfaceHolder
+import java.util.concurrent.Executors
+import kotlin.math.min
+
+/** Live wallpaper: the only way to get a true 60 fps gyro render on the home screen. */
+class DepthWallpaperService : WallpaperService() {
+    override fun onCreateEngine(): Engine = DepthEngine()
+
+    inner class DepthEngine : WallpaperService.Engine(), Choreographer.FrameCallback {
+        private val tilt = TiltSensor(this@DepthWallpaperService)
+        private val renderer = ParallaxRenderer()
+        private val loader = Executors.newSingleThreadExecutor()
+        private val main = Handler(Looper.getMainLooper())
+        private var settings = RenderSettings.load(this@DepthWallpaperService)
+        private var photo: Photo? = null
+        private var prev: Photo? = null
+        private var fade = 1f
+        private var visible = false
+        private var width = 0
+        private var height = 0
+        private var lastNanos = 0L
+        private var loadedVersion = -1
+        private var lastTap = 0L
+
+        override fun onCreate(surfaceHolder: SurfaceHolder) {
+            super.onCreate(surfaceHolder)
+            loadCurrent()
+        }
+
+        override fun onSurfaceChanged(holder: SurfaceHolder, format: Int, w: Int, h: Int) {
+            super.onSurfaceChanged(holder, format, w, h)
+            width = w
+            height = h
+            tilt.refreshRotation()
+        }
+
+        override fun onVisibilityChanged(isVisible: Boolean) {
+            visible = isVisible
+            val choreographer = Choreographer.getInstance()
+            if (isVisible) {
+                settings = RenderSettings.load(this@DepthWallpaperService)
+                tilt.idleFloat = settings.idleFloat
+                if (PhotoStore.version(this@DepthWallpaperService) != loadedVersion) loadCurrent()
+                lastNanos = 0L
+                tilt.start()
+                choreographer.removeFrameCallback(this)
+                choreographer.postFrameCallback(this)
+            } else {
+                tilt.stop()
+                choreographer.removeFrameCallback(this)
+            }
+        }
+
+        override fun onSurfaceDestroyed(holder: SurfaceHolder) {
+            visible = false
+            tilt.stop()
+            Choreographer.getInstance().removeFrameCallback(this)
+            super.onSurfaceDestroyed(holder)
+        }
+
+        override fun onDestroy() {
+            visible = false
+            tilt.stop()
+            Choreographer.getInstance().removeFrameCallback(this)
+            loader.shutdownNow()
+            super.onDestroy()
+        }
+
+        override fun onCommand(action: String?, x: Int, y: Int, z: Int, extras: Bundle?, resultRequested: Boolean): Bundle? {
+            if (action == WallpaperManager.COMMAND_TAP) {
+                val now = SystemClock.uptimeMillis()
+                if (now - lastTap < 450L) {
+                    PhotoStore.step(this@DepthWallpaperService, 1)
+                    loadCurrent()
+                    lastTap = 0L
+                } else lastTap = now
+            }
+            return super.onCommand(action, x, y, z, extras, resultRequested)
+        }
+
+        private fun loadCurrent() {
+            val version = PhotoStore.version(this@DepthWallpaperService)
+            val uri = PhotoStore.current(this@DepthWallpaperService)
+            loadedVersion = version
+            if (uri == null) return
+            loader.execute {
+                val bmp = BitmapLoader.load(this@DepthWallpaperService, uri, 2048)
