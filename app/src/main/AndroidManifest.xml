<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:theme="@style/AppTheme" android:label="DepthMotion" android:allowBackup="true">
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <receiver android:name=".DepthMotionWidget" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.jaydeep.depthmotion.REFRESH"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/depthmotion_widget_info"/>
        </receiver>
    </application>
</manifest>
